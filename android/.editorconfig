# ktlint rules — spec §24.1's ktlint enforcement (Phase 0 exit gate 4).
# This file is named `.editorconfig` on purpose: ktlint discovers editorconfig
# files by walking up from each source file, so `android/config/ktlint.editorconfig`
# would never have been read. Detekt's config keeps the `config/` convention
# (`config/detekt.yml`), but ktlint needs the real filename.
[*.{kt,kts}]
max_line_length = 100
# Compose composables are PascalCase by convention; the function-naming rule
# would flag every @Composable function. ktlint's standard opt-out for this
# (Compose's own convention) is to ignore functions annotated @Composable.
ktlint_function_naming_ignore_when_annotated_with = Composable

# Test source files are allowed a longer line: the canary test in
# app/src/test/java/.../VersionMappingTest.kt carries an interpolated
# error message that the assertion itself reads back, and the
# "X must be > Y" formulation reads more cleanly as a single line
# than as a wrapped one. Production sources keep the 100-char
# cap. The override is scoped to the test path only.
# ktlint's editorconfig globbing matches paths segment-by-segment;
# `app/src/test/**` does NOT match `app/src/test/java/.../Foo.kt`
# because the `**` must consume at least one segment, and the
# `app/src/test/` segment is the exact prefix. Use `**/test/**` so
# the pattern hits every test file under any depth, with the `kt,kts`
# extension filter applied after the directory glob resolves.
[**/test/**.{kt,kts}]
max_line_length = 120

# The fixture in app/src/test/resources/sample-build.gradle.kts is a
# sample read as plain text by VersionMappingTest; it is not compiled.
# Skip ktlint for it so the assertion can carry a slightly-longer
# line that mirrors the production build script without inheriting
# the 100/120-char caps the live sources follow.
[app/src/test/resources/**.{kt,kts}]
ktlint_excludes = true

# The production Gradle build scripts at app/build.gradle.kts and
# root settings.gradle.kts are reviewed by ktlint's
# `runKtlintCheckOverMainSourceSet` and `ktlintKotlinScriptCheck` tasks.
# Their line length cap stays at 100; their concern is that
# long interpolated messages are easy to overlook in code review
# and a 100-char cap forces a wrap that makes the message readable.
# The test source override above is the one place where a longer
# cap is acceptable, and only because the assertion reads the
# message back. Production build scripts keep the same 100-char
# cap the rest of the project follows.
