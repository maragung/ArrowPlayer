<?xml version="1.0" encoding="utf-8"?>
<!--
    Eclipse Player — Android manifest (spec §5 app module).

    Phase 0 scaffold: one launcher activity. MediaLibraryService, the Android
    Auto browse tree and the foreground playback service (§15) arrive with the
    phases that own them; declaring them now, empty, would be the OQ-042 shape —
    a component that exists on paper and does nothing.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.EclipsePlayer">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
