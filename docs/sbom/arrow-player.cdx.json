    "properties": [
      {
        "name": "arrow:register",
        "value": "tools/gen-third-party/register.json"
      },
      {
        "name": "arrow:spec-section",
        "value": "4.2"
      },
      {
        "name": "arrow:requirements",
        "value": "REQ-GEN-021, REQ-SEC-014, REQ-GEN-012"
      },
      {
        "name": "arrow:component-set",
        "value": "direct-only"
      },
      {
        "name": "arrow:vcpkg-builtin-baseline",
        "value": "9e593bb18ea69cc5095e012465dcd675a822ed0d"
      },
      {
        "name": "arrow:vcpkg-triplet",
        "value": "x64-linux-arrow"
      },
      {
        "name": "arrow:qt-version",
        "value": "6.8.2 (not a vcpkg port; aqtinstall per ADR 0005)"
      },
      {
        "name": "arrow:android-entries-omitted",
        "value": "6 — the Android app is a Phase 0 scaffold (ADR 0012) whose Gradle dependencies are not yet reconciled with the §4.2 register, so no Android component is described here; this document covers the desktop build"
      },
      {
        "name": "arrow:components-without-exact-version",
        "value": "10 of 13 (taglib, soundtouch, libsamplerate, chromaprint, projectm, sqlite3, nlohmann-json, libzip, zlib, rtaudio) — OQ-047"
      },
      {
        "name": "arrow:cpe-absent",
        "value": "no component carries a cpe: the register records no CPE names and this tool will not invent them. osv-scanner maps neither the vcpkg nor the generic purl type to any ecosystem, trivy skips both as unknown before matching, and grype resolves no CPE unless --add-cpes-if-none is passed, so a purl-only CVE scan over this document is not evidence of no known vulnerabilities (OQ-046)"
      },
      {
        "name": "arrow:validation",
        "value": "this generator checks structure only. The document has been validated against the canonical bom-1.6.schema.json in a one-off local run; the committed validator implements a draft-2020-12 subset and the CycloneDX schemas are draft-07, so CI validates with cyclonedx-cli --input-version v1_6, which embeds its schemas (OQ-048)"
      }
    ]
  },
