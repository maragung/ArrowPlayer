    {
      "id": "req-pls-013-matches-glob-star",
      "intent": "MATCHES uses glob `*`, not regex `.*`",
      "req": "REQ-PLS-013",
      "text": "path MATCHES '*/Live/*'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "path",
          "operator": "matches",
          "value": "*/Live/*"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "path GLOB ?",
        "params": [
          "*/Live/*"
        ]
      },
      "note": "Glob, not a regular expression. Regex is deliberately excluded because catastrophic backtracking is a denial-of-service surface inside a rule the user can share in a playlist file."
    },
    {
      "id": "req-pls-013-matches-regex-is-literal",
      "intent": "A regex metacharacter is a literal in glob",
      "req": "REQ-PLS-013",
      "text": "title MATCHES 'a.*b'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "title",
          "operator": "matches",
          "value": "a.*b"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "title GLOB ?",
        "params": [
          "a.*b"
        ]
      },
      "note": "`a.*b` matches a literal dot followed by any run: `a.xb` matches, `aab` does not. An implementation that quietly treats MATCHES as regex fails this case, which is exactly why it is a fixture."
    },
    {
      "id": "req-pls-013-matches-catastrophic-pattern-is-safe",
      "intent": "A pattern that would hang a backtracking regex engine",
      "req": "REQ-PLS-013",
      "text": "title MATCHES '*a*a*a*a*a*a*b'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "title",
          "operator": "matches",
          "value": "*a*a*a*a*a*a*b"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "title GLOB ?",
        "params": [
          "*a*a*a*a*a*a*b"
        ]
      },
      "note": "Under `(a+)+b` semantics this is exponential. Under glob it is linear. The case exists so a future switch to regex cannot pass the suite."
    },
    {
      "id": "case-insensitive-default",
      "intent": "String comparison is case-insensitive by default",
      "text": "artist = 'bjork'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "artist",
          "operator": "eq",
          "value": "bjork"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "artist = ? COLLATE NOCASE",
        "params": [
          "bjork"
        ]
      },
      "note": "Matches how a listener thinks about their library. §9.2.3's sort keys use the same collation, so filtering and sorting cannot disagree."
    },
    {
      "id": "case-sensitive-opt-in",
      "intent": "caseSensitive: true opts out",
      "text": "artist = 'bjork'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "artist",
          "operator": "eq",
          "value": "bjork",
          "caseSensitive": true
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "artist = ?",
        "params": [
          "bjork"
        ]
      }
    },
