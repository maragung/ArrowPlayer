{
  "schemaVersion": 1,
  "$comment": "Conformance fixtures for smart playlists. Source: eclipse-player.md §9.6. REQ-PLS-012 requires the eight worked examples in this file; they carry req: REQ-PLS-012 and are the first eight cases. Every case gives the text form (grammars/smart-playlist.ebnf), the canonical JSON rule (schemas/smart-playlist.schema.json), whether the rule is schema-valid, and for valid rules the expected parameterised SQL fragment with its bound parameters. expectSql.where is a normalised fragment: whitespace-insensitive, table alias `t`, `?` placeholders. An implementation may emit different but equivalent SQL, in which case it MUST record the deviation and MUST still bind exactly expectSql.params in order — the parameter list, not the SQL text, is what REQ-SEC-009 constrains. REQ-GEN-031 requires desktop and Android to produce identical verdicts on every case here.",
  "cases": [
    {
      "id": "req-pls-012-neglected-favourites",
      "intent": "Neglected favourites",
      "req": "REQ-PLS-012",
      "text": "rating >= 80 AND (lastplayed < -180d OR lastplayed IS NULL)",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "rating",
              "operator": "gte",
              "value": 80
            },
            {
              "op": "or",
              "rules": [
                {
                  "field": "lastplayed",
                  "operator": "lt",
                  "value": "-180d"
                },
                {
                  "field": "lastplayed",
                  "operator": "isNull"
                }
              ]
            }
          ]
        },
        "name": "Neglected favourites"
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(rating >= ? AND (lastplayed < ? OR lastplayed IS NULL))",
        "params": [
          80,
          "-180d"
        ]
      },
      "note": "`IS NULL` takes no operand, so it contributes no bound parameter. A rule that emitted a placeholder for it would bind one value too many."
    },
    {
      "id": "req-pls-012-fresh-and-unheard",
      "intent": "Fresh and unheard",
      "req": "REQ-PLS-012",
      "text": "added > -14d AND playcount = 0 ORDER BY added DESC LIMIT 100",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "added",
              "operator": "gt",
              "value": "-14d"
            },
            {
              "field": "playcount",
              "operator": "eq",
              "value": 0
            }
          ]
        },
        "name": "Fresh and unheard",
        "orderBy": [
          {
            "field": "added",
            "direction": "desc"
          }
        ],
        "limit": 100
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(added > ? AND playcount = ?)",
        "params": [
          "-14d",
          0
        ]
      },
      "note": "ORDER BY and LIMIT are structure, not operands: the column name and direction are chosen from a closed set at compile time and never interpolated from user text."
    },
    {
      "id": "req-pls-012-good-jazz",
      "intent": "Good jazz, well-played",
      "req": "REQ-PLS-012",
      "text": "genre CONTAINS 'Jazz' AND playcount > 5",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "genre",
              "operator": "contains",
              "value": "Jazz"
            },
            {
              "field": "playcount",
              "operator": "gt",
              "value": 5
            }
          ]
        },
        "name": "Good jazz, well-played"
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(genre LIKE ? AND playcount > ?)",
        "params": [
          "%Jazz%",
          5
        ]
      },
      "note": "CONTAINS becomes LIKE with the wildcards added to the BOUND VALUE, never to the SQL text. `%` and `_` inside the user's value are escaped so a search for `50%` does not become a wildcard."
    },
    {
      "id": "req-pls-012-hi-res-only",
      "intent": "Hi-res only",
      "req": "REQ-PLS-012",
      "text": "islossless = true AND (samplerate > 48000 OR bitdepth > 16)",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "islossless",
              "operator": "eq",
              "value": true
            },
            {
              "op": "or",
              "rules": [
                {
                  "field": "samplerate",
                  "operator": "gt",
                  "value": 48000
                },
                {
                  "field": "bitdepth",
                  "operator": "gt",
                  "value": 16
                }
              ]
            }
          ]
        },
        "name": "Hi-res only"
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(islossless = ? AND (samplerate > ? OR bitdepth > ?))",
        "params": [
          true,
          48000,
          16
        ]
      }
    },
    {
      "id": "req-pls-012-long-form",
      "intent": "Long-form",
      "req": "REQ-PLS-012",
      "text": "duration > 10m AND NOT genre CONTAINS 'Podcast'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "duration",
              "operator": "gt",
              "value": "10m"
            },
            {
              "field": "genre",
              "operator": "contains",
              "value": "Podcast",
              "not": true
            }
          ]
        },
        "name": "Long-form"
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(duration > ? AND NOT (genre LIKE ?))",
        "params": [
          600,
          "%Podcast%"
        ]
      },
      "note": "`10m` is a duration literal and compiles to 600 — seconds, the unit of the `duration` column. The literal is normalised BEFORE binding, so the database never parses a unit suffix."
    },
    {
      "id": "req-pls-012-workout",
      "intent": "Workout",
      "req": "REQ-PLS-012",
      "text": "bpm BETWEEN 120 AND 140 AND loved = true ORDER BY random LIMIT 50",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "bpm",
              "operator": "between",
              "from": 120,
              "to": 140
            },
            {
              "field": "loved",
              "operator": "eq",
              "value": true
            }
          ]
        },
        "name": "Workout",
        "orderBy": [
          {
            "field": "random"
          }
        ],
        "limit": 50
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(bpm BETWEEN ? AND ? AND loved = ?)",
        "params": [
          120,
          140,
          true
        ]
      },
      "note": "BETWEEN binds two parameters and is inclusive at both ends. `ORDER BY random` maps to the backend's own random function, chosen at compile time — not to a value."
    },
    {
      "id": "req-pls-012-custom-taxonomy",
      "intent": "Custom taxonomy",
      "req": "REQ-PLS-012",
      "text": "custom:mood = 'melancholy' AND year < 1990",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "op": "and",
          "rules": [
            {
              "field": "custom:mood",
              "operator": "eq",
              "value": "melancholy"
            },
            {
              "field": "year",
              "operator": "lt",
              "value": 1990
            }
          ]
        },
        "name": "Custom taxonomy"
      },
      "schemaValid": true,
      "expectSql": {
        "where": "(EXISTS (SELECT 1 FROM custom_tags ct WHERE ct.track_id = t.id AND ct.key = ? AND ct.value = ?) AND year < ?)",
        "params": [
          "mood",
          "melancholy",
          1990
        ]
      },
      "note": "A custom field's NAME is a bound parameter too. It is user-supplied text, and the one thing that must never happen is a user-chosen tag name reaching the query as SQL."
    },
    {
      "id": "req-pls-012-needs-attention",
