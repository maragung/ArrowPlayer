    {
      "id": "sec-injection-in-value",
      "intent": "A value containing SQL is data, not code",
      "req": "REQ-SEC-009",
      "text": "title = ''; DROP TABLE tracks; --'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "title",
          "operator": "eq",
          "value": "'; DROP TABLE tracks; --"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "title = ? COLLATE NOCASE",
        "params": [
          "'; DROP TABLE tracks; --"
        ]
      },
      "note": "The value reaches the database as one bound string and matches nothing. The SQL text is identical to the harmless case above it — that identity IS the property being tested."
    },
    {
      "id": "sec-injection-in-custom-field-name",
      "intent": "A custom field name containing SQL is rejected before compilation",
      "req": "REQ-SEC-009",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "custom:x' OR 1=1 --",
          "operator": "eq",
          "value": "y"
        }
      },
      "schemaValid": false,
      "expectSchemaError": "custom field name is not a valid identifier",
      "note": "Defence in depth, and the order matters. The schema's identifier pattern `^custom:[A-Za-z_][A-Za-z0-9_]{0,63}$` rejects this rule outright, so a hostile tag name never reaches the compiler. The next case proves that even a name that IS valid is still bound rather than interpolated, because a validator and a compiler that both have to be right is weaker than either one being sufficient."
    },
    {
      "id": "sec-custom-field-name-is-bound",
      "intent": "A valid custom field name is still a bound parameter",
      "req": "REQ-SEC-009",
      "text": "custom:mood = 'melancholy'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "custom:mood",
          "operator": "eq",
          "value": "melancholy"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "EXISTS (SELECT 1 FROM custom_tags ct WHERE ct.track_id = t.id AND ct.key = ? AND ct.value = ?)",
        "params": [
          "mood",
          "melancholy"
        ]
      },
      "note": "Two bound parameters: the tag name and the tag value. The name is user-supplied text and is bound for the same reason the value is."
    },
    {
      "id": "sec-like-wildcards-escaped",
      "intent": "LIKE metacharacters in a value are escaped",
      "req": "REQ-SEC-009",
      "text": "album CONTAINS '100%_live'",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "album",
          "operator": "contains",
          "value": "100%_live"
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "album LIKE ? ESCAPE '\\'",
        "params": [
          "%100\\%\\_live%"
        ]
      },
      "note": "Without escaping, a search for `100%_live` would match `100 anything live`. The ESCAPE clause is fixed SQL text; only the pattern is bound."
    },
