      },
      "schemaValid": false,
      "expectSchemaError": "schemaVersion is required"
    },
    {
      "id": "invalid-additional-property",
      "intent": "Unknown members are rejected, not ignored",
      "rule": {
        "schemaVersion": 1,
        "match": {
          "field": "loved",
          "operator": "eq",
          "value": true
        },
        "sortBy": "artist"
      },
      "schemaValid": false,
      "expectSchemaError": "additional property sortBy",
      "note": "A stored rule is not a network message: tolerating an unknown member here would let a typo like `sortBy` silently do nothing while the user believes it works."
    }
  ]
