            "Blues",
            "Soul"
          ]
        }
      },
      "schemaValid": true,
      "expectSql": {
        "where": "genre IN (?, ?, ?)",
        "params": [
          "Jazz",
          "Blues",
          "Soul"
        ]
      },
      "note": "One placeholder per value, generated from the list LENGTH — a count, which is structure, never from the values themselves."
    },
    {
